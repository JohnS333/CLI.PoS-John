<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Maui.PoS.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maui.PoS"
    xmlns:views="clr-namespace:Maui.PoS.Views"
    Title="Maui.PoS">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
                <!-- {DataTemplate views:AdminMainView} is C# binding syntax
        Its an expression that says, when i navigate MainPage route, it will find local:MainPage
        and load it into the shell -->

    <ShellContent
        Title="Administration"
        ContentTemplate="{DataTemplate views:AdminMainView}"
        Route="AdminMenu" />

</Shell>
